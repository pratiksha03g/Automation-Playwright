{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true
  },
  "include": ["playwright.config.ts", "src/**/*.ts", "tests/api/**/*.ts", "tests/e2e/**/*.ts"],
  "exclude": ["node_modules", "test-results", "reports"]
}
