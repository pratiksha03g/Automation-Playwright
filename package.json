{
  "name": "playwrightautomation",
  "version": "1.0.0",
  "description": "JavaScript Playwright automation",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "main": "playwright.config.js",
  "scripts": {
    "test": "playwright test --config=playwright.config.js",
    "test:chromium": "playwright test --config=playwright.config.js --project=chromium",
    "test:headed": "playwright test --config=playwright.config.js --project=chromium --headed",
    "test:ui": "playwright test --config=playwright.config.js --ui",
    "test:debug": "playwright test --config=playwright.config.js --debug",
    "report": "playwright show-report playwright-report",
    "lint": "eslint playwright.config.js eslint.config.js src/pages src/fixtures src/testdata src/tests",
    "format": "prettier --write playwright.config.js eslint.config.js package.json",
    "format:check": "prettier --check playwright.config.js eslint.config.js package.json"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "dotenv": "^16.6.1",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
